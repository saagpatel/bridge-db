#!/bin/sh
set -eu

env_file=${BRIDGE_DB_ENV_FILE:-/Users/d/.codex/secrets/bridge-db.env}
case "$env_file" in
    /*) ;;
    *)
        echo "bridge_db.wrapper_env_path_not_absolute" >&2
        exit 78
        ;;
esac
if [ ! -f "$env_file" ] || [ -L "$env_file" ]; then
    echo "bridge_db.wrapper_env_file_invalid" >&2
    exit 78
fi

env_owner=$(stat -f '%u' "$env_file" 2>/dev/null || stat -c '%u' "$env_file" 2>/dev/null) || {
    echo "bridge_db.wrapper_env_stat_failed" >&2
    exit 78
}
env_mode=$(stat -f '%Lp' "$env_file" 2>/dev/null || stat -c '%a' "$env_file" 2>/dev/null) || {
    echo "bridge_db.wrapper_env_stat_failed" >&2
    exit 78
}
if [ "$env_owner" -ne "$(id -u)" ] || [ "$env_mode" != "600" ]; then
    echo "bridge_db.wrapper_env_file_not_private" >&2
    exit 78
fi

token_seen=0
auth_seen=0
bridge_token=
bridge_auth_mode=
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ''|'#'*) ;;
        BRIDGE_DB_PRINCIPAL_TOKEN=*)
            if [ "$token_seen" -ne 0 ]; then
                echo "bridge_db.wrapper_env_duplicate_key" >&2
                exit 78
            fi
            token_seen=1
            bridge_token=${line#BRIDGE_DB_PRINCIPAL_TOKEN=}
            ;;
        BRIDGE_DB_AUTH_MODE=*)
            if [ "$auth_seen" -ne 0 ]; then
                echo "bridge_db.wrapper_env_duplicate_key" >&2
                exit 78
            fi
            auth_seen=1
            bridge_auth_mode=${line#BRIDGE_DB_AUTH_MODE=}
            ;;
        *)
            echo "bridge_db.wrapper_env_unknown_key" >&2
            exit 78
            ;;
    esac
done < "$env_file"

if [ "$token_seen" -ne 1 ] || [ "${#bridge_token}" -lt 32 ]; then
    echo "bridge_db.wrapper_token_invalid" >&2
    exit 78
fi
case "$bridge_auth_mode" in
    off|warn|enforce) ;;
    *)
        echo "bridge_db.wrapper_auth_mode_invalid" >&2
        exit 78
        ;;
esac

BRIDGE_DB_PRINCIPAL_TOKEN=$bridge_token
BRIDGE_DB_AUTH_MODE=$bridge_auth_mode
export BRIDGE_DB_PRINCIPAL_TOKEN BRIDGE_DB_AUTH_MODE
unset BRIDGE_DB_ENV_FILE bridge_token bridge_auth_mode line env_owner env_mode
exec /Users/d/.local/state/bridge-db/current/bin/bridge-db-mcp "$@"
